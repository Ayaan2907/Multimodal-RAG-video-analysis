# ---- Supabase (project settings > API) ----
# Service role key: server-only, never expose to the browser. Rotate from your
# dashboard if it was ever committed or shared.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- AI providers (env only — no code fallbacks) ----
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-key
GROQ_API_KEY=your-groq-key
ASSEMBLYAI_API_KEY=your-assemblyai-key
# Optional: YouTube Data API for richer metadata
YOUTUBE_API_KEY=

# ---- Model IDs (defaults below are current; override to pin) ----
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# ---- Retrieval / pipeline tuning ----
# Similarity floor for chat retrieval (must be strictly between 0 and 1).
MATCH_THRESHOLD=0.5
# Embedding vector size; 768 keeps the pgvector column and match_embeddings RPC compatible.
EMBEDDING_DIMENSIONS=768
# Max allowed YouTube video duration in minutes
MAX_VIDEO_DURATION_MINUTES=30
# Scratch directory for uploaded video/audio temp files
TEMP_DIR=/tmp
